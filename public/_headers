# Cloudflare Pages 安全响应头
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Link: </sitemap-index.xml>; rel="sitemap"
  Link: </llms.txt>; rel="llms"

# Machine-readable markdown variants — force text/markdown Content-Type
# + noindex (duplicate content face vs the HTML pages; kept crawlable for AI/API use)
/vehicles/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex

/blog/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex

# Machine-readable JSON endpoints — noindex (duplicate/alternate data face)
/data/*.json
  X-Robots-Tag: noindex
