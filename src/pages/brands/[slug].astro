---
import { getCollection, render } from 'astro:content';
import SEO from '@/components/common/SEO.astro';
import { url as siteUrl } from '@/config/site';

export async function getStaticPaths() {
  const brands = await getCollection('brands');
  return brands.map((b) => ({
    params: { slug: b.id.replace(/\.mdx?$/, '') },
  }));
}

const { slug } = Astro.params;
const brands = await getCollection('brands');
const brandEntry = brands.find((b) => b.id.replace(/\.mdx?$/, '') === slug);
const { data } = brandEntry;
const { Content } = await render(brandEntry);

// Brand JSON-LD schema
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: data.brand_name,
  description: data.description,
  url: siteUrl + '/brands/' + slug + '/',
  foundingDate: data.established,
  parentOrganization: data.parent_manufacturer
    ? { '@type': 'Organization', name: data.parent_manufacturer, location: data.parent_location }
    : undefined,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Brands', item: `${siteUrl}/brands/` },
    { '@type': 'ListItem', position: 3, name: data.brand_name },
  ],
};
---

<SEO title={data.title} description={data.description} />

<article class="max-w-4xl mx-auto px-6 py-12">
  <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
    <a href="/">Home</a> / <a href="/brands/">Brands</a> / <span>{data.brand_name}</span>
  </nav>

  <div class="mb-8">
    <span class="inline-block px-3 py-1 bg-green-600/10 text-green-600 rounded-full text-xs font-medium">{data.model_count} models</span>
    <span class="inline-block px-3 py-1 bg-gray-600/10 text-gray-600 rounded-full text-xs font-medium ml-2">Est. {data.established}</span>
  </div>

  <h1 class="text-4xl font-bold mb-2">{data.brand_name}</h1>
  <p class="text-lg text-gray-600 mb-4">Parent: {data.parent_manufacturer} · {data.parent_location} (founded {data.parent_founded})</p>
  {data.website && <p class="text-sm mb-6"><a href={data.website} class="text-green-600 hover:underline" rel="noopener">Official website ↗</a></p>}

  <div class="prose prose-lg max-w-none mb-10">
    <Content />
  </div>

  <div class="border-t pt-6 text-sm text-gray-500">
    Author: Wei Wang (Marketing Specialist) · Guangzhou Banghe Testing Technology Co., Ltd. (MCM) · Contact: Aaron.W · aaron@dinweys.com · WhatsApp/WeChat +86 13313137465 · Updated {data.publishedDate.toISOString().split('T')[0]}
  </div>
</article>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
