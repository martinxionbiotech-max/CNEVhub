---
import { getCollection, render } from 'astro:content';
import SEO from '@/components/common/SEO.astro';
import { url as siteUrl } from '@/config/site';

export async function getStaticPaths() {
  const vehicles = await getCollection('vehicles');
  return vehicles.map((v) => ({
    params: { slug: v.data.slug },
  }));
}

const { slug } = Astro.params;
const vehicles = await getCollection('vehicles');
const vehicle = vehicles.find((v) => v.data.slug === slug);
const { data } = vehicle;
const { Content } = await render(vehicle);
const lc = data.landed_cost || {};

// 构建 JSON-LD Vehicle schema
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Vehicle',
  name: data.title,
  description: data.description,
  brand: { '@type': 'Brand', name: data.brand.toUpperCase() },
  vehicleModelDate: '2026',
  bodyType: data.type,
  fuelType: 'Electric',
  numberOfDoors: 4,
  numberOfAirbags: '8',
  vehicleEngine: data.motor_power_kw ? { '@type': 'EngineSpecification', enginePower: { '@type': 'QuantitativeValue', value: data.motor_power_kw, unitCode: 'KWT' } } : undefined,
  offers: {
    '@type': 'Offer',
    price: data.price_usd,
    priceCurrency: data.currency,
    availability: 'https://schema.org/InStock',
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Vehicles', item: `${siteUrl}/vehicles/` },
    { '@type': 'ListItem', position: 3, name: data.title },
  ],
};
---

<SEO title={data.title} description={data.description} />

<article class="max-w-4xl mx-auto px-6 py-12">
  <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
    <a href="/">Home</a> / <a href="/vehicles/">Vehicles</a> / <span>{data.title}</span>
  </nav>

  <div class="mb-8">
    <span class="inline-block px-3 py-1 bg-emerald-600/10 text-emerald-700 rounded-full text-xs font-medium mr-2">{data.type}</span>
    <span class="inline-block px-3 py-1 bg-emerald-600/10 text-emerald-600 rounded-full text-xs font-medium">{data.powertrain}</span>
    <span class="inline-block px-3 py-1 bg-gray-600/10 text-gray-600 rounded-full text-xs font-medium ml-2">{data.brand.toUpperCase()}</span>
  </div>

  {data.image && (
    <div class="mb-6 overflow-hidden rounded-lg border border-gray-200">
      <img src={data.image} alt={data.title} class="w-full h-auto object-cover" loading="eager" width="800" height="450" />
    </div>
  )}

  <h1 class="text-4xl font-bold mb-2">{data.title}</h1>
  <p class="text-2xl text-emerald-700 font-semibold mb-6">${data.price_usd.toLocaleString()} <span class="text-sm font-normal text-gray-500">starting price</span></p>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    {data.range_cltc_km && <div class="p-4 bg-gray-50 rounded-lg"><div class="text-2xl font-bold">{data.range_cltc_km} km</div><div class="text-xs text-gray-500">Range (CLTC)</div></div>}
    {data.battery_kwh && <div class="p-4 bg-gray-50 rounded-lg"><div class="text-2xl font-bold">{data.battery_kwh} kWh</div><div class="text-xs text-gray-500">Battery</div></div>}
    {data.motor_power_kw && <div class="p-4 bg-gray-50 rounded-lg"><div class="text-2xl font-bold">{data.motor_power_kw} kW</div><div class="text-xs text-gray-500">Motor Power</div></div>}
    {data.accel_0_100_s && <div class="p-4 bg-gray-50 rounded-lg"><div class="text-2xl font-bold">{data.accel_0_100_s}s</div><div class="text-xs text-gray-500">0-100 km/h</div></div>}
  </div>

  <div class="prose prose-lg max-w-none mb-10">
    <Content />
  </div>

  <div class="border-t pt-6 text-sm text-gray-500">
    Author: {data.author} · Guangzhou Banghe Testing Technology Co., Ltd. (MCM) · Updated {data.publishedDate.toISOString().split('T')[0]}
  </div>
</article>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
