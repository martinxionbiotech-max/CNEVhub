---
import { getCollection, render } from 'astro:content';
import SEO from '@/components/common/SEO.astro';
import { url as siteUrl } from '@/config/site';

export async function getStaticPaths() {
  const vehicles = await getCollection('vehicles');
  return vehicles.map((v) => ({
    params: { slug: v.data.slug },
  }));
}

const { slug } = Astro.params;
const vehicles = await getCollection('vehicles');
const vehicle = vehicles.find((v) => v.data.slug === slug);
const { data } = vehicle;
const { Content } = await render(vehicle);
const lc = data.landed_cost || {};
const multiLc = data.landed_cost_markets || [];

// 构建规格表数据项
const specs = [
  { label: 'Powertrain', value: data.powertrain },
  { label: 'Body type', value: data.type },
  { label: 'Range (CLTC)', value: data.range_cltc_km ? `${data.range_cltc_km} km` : null },
  { label: 'Battery', value: data.battery_kwh ? `${data.battery_kwh} kWh` : null },
  { label: 'Motor power', value: data.motor_power_kw ? `${data.motor_power_kw} kW` : null },
  { label: 'Torque', value: data.torque_nm ? `${data.torque_nm} Nm` : null },
  { label: '0-100 km/h', value: data.accel_0_100_s ? `${data.accel_0_100_s} s` : null },
  { label: 'Top speed', value: data.top_speed_kmh ? `${data.top_speed_kmh} km/h` : null },
  { label: 'Length', value: data.length_mm ? `${data.length_mm} mm` : null },
  { label: 'Width', value: data.width_mm ? `${data.width_mm} mm` : null },
  { label: 'Height', value: data.height_mm ? `${data.height_mm} mm` : null },
  { label: 'Wheelbase', value: data.wheelbase_mm ? `${data.wheelbase_mm} mm` : null },
  { label: 'Curb weight', value: data.weight_kg ? `${data.weight_kg} kg` : null },
  { label: 'Efficiency', value: data.efficiency_kwh_100km ? `${data.efficiency_kwh_100km} kWh/100km` : null },
  { label: 'Fast charge', value: data.fast_charge && data.fast_charge !== '-' ? data.fast_charge : null },
].filter((s) => s.value);

// JSON-LD Vehicle schema（含完整规格）
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Vehicle',
  name: data.title,
  description: data.description,
  brand: { '@type': 'Brand', name: data.brand.toUpperCase() },
  vehicleModelDate: '2026',
  bodyType: data.type,
  fuelType: 'Electric',
  numberOfDoors: 4,
  vehicleEngine: data.motor_power_kw ? { '@type': 'EngineSpecification', enginePower: { '@type': 'QuantitativeValue', value: data.motor_power_kw, unitCode: 'KWT' } } : undefined,
  offers: {
    '@type': 'Offer',
    price: data.price_usd,
    priceCurrency: data.currency,
    availability: 'https://schema.org/InStock',
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Vehicles', item: `${siteUrl}/vehicles/` },
    { '@type': 'ListItem', position: 3, name: data.title },
  ],
};
---

<SEO title={data.title} description={data.description} />

<article class="max-w-4xl mx-auto px-6 py-12">
  <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
    <a href="/" class="hover:text-green-600">Home</a> / <a href="/vehicles/" class="hover:text-green-600">Vehicles</a> / <span>{data.title}</span>
  </nav>

  <div class="mb-8">
    <span class="inline-block px-3 py-1 bg-green-600/10 text-green-700 rounded-full text-xs font-medium mr-2">{data.type}</span>
    <span class="inline-block px-3 py-1 bg-green-600/10 text-green-600 rounded-full text-xs font-medium">{data.powertrain}</span>
    <span class="inline-block px-3 py-1 bg-gray-600/10 text-gray-600 rounded-full text-xs font-medium ml-2">{data.brand.toUpperCase()}</span>
  </div>

  {data.image && (
    <div class="mb-6 overflow-hidden rounded-lg border border-gray-200">
      <img src={data.image} alt={data.title} class="w-full h-auto object-cover" loading="eager" width="800" height="450" />
    </div>
  )}

  <h1 class="text-4xl font-bold mb-2">{data.title}</h1>
  <p class="text-2xl text-green-700 font-semibold mb-8">${data.price_usd.toLocaleString()} <span class="text-sm font-normal text-gray-500">starting price</span></p>

  <!-- 关键指标卡片 -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
    {data.range_cltc_km && <div class="p-4 bg-gray-50 rounded-lg"><div class="text-2xl font-bold text-gray-900">{data.range_cltc_km} km</div><div class="text-xs text-gray-500">Range (CLTC)</div></div>}
    {data.battery_kwh && <div class="p-4 bg-gray-50 rounded-lg"><div class="text-2xl font-bold text-gray-900">{data.battery_kwh} kWh</div><div class="text-xs text-gray-500">Battery</div></div>}
    {data.motor_power_kw && <div class="p-4 bg-gray-50 rounded-lg"><div class="text-2xl font-bold text-gray-900">{data.motor_power_kw} kW</div><div class="text-xs text-gray-500">Motor Power</div></div>}
    {data.accel_0_100_s && <div class="p-4 bg-gray-50 rounded-lg"><div class="text-2xl font-bold text-gray-900">{data.accel_0_100_s}s</div><div class="text-xs text-gray-500">0-100 km/h</div></div>}
  </div>

  <!-- 完整规格表 -->
  <h2 class="text-2xl font-bold mb-4">Specifications</h2>
  <div class="rounded-lg border border-gray-200 overflow-hidden mb-10">
    <table class="w-full text-sm">
      <tbody>
        {specs.map((s, i) => (
          <tr class={i % 2 === 0 ? 'bg-gray-50' : 'bg-white'}>
            <td class="px-4 py-3 font-medium text-gray-700 w-1/3">{s.label}</td>
            <td class="px-4 py-3 text-gray-900">{s.value}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="prose prose-lg max-w-none mb-10">
    <Content />
  </div>

  <div class="border-t pt-6 text-sm text-gray-500">
    Author: {data.author} (Marketing Specialist) · Guangzhou Banghe Testing Technology Co., Ltd. (MCM) · Contact: Aaron.W · aaron@dinweys.com · WhatsApp/WeChat +86 13313137465 · Updated {data.publishedDate ? data.publishedDate.toISOString().split('T')[0] : '2026-09-05'}
  </div>
</article>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
